# The build context is the repository root; keep it to what the image needs.

.git/
.github/
.claude/
.vscode/
openspec/

# Nothing outside backend/ and deploy/ belongs in the image yet.
# (The frontend build stage adds frontend/ in a later change.)
frontend/node_modules/
frontend/dist/

# Python artefacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.swp
.venv/
venv/
.env
*.env
!deploy/.env.example

# Test / coverage artefacts
.coverage
htmlcov/
.pytest_cache/
.ruff_cache/
.tox/
*.db

# Logs and OS files
*.log
.DS_Store
Thumbs.db
