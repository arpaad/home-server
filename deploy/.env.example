# Copy to deploy/.env and adjust. deploy/.env is gitignored.

# ---- exposure ----
# Bind the API to the LAN address of the machine running it. This release has
# NO AUTHENTICATION, so never bind it to a public interface and never
# port-forward it.
HOME_BIND_ADDRESS=127.0.0.1
HOME_PORT=8080

# Local development only (deploy/compose.yaml); the deploy stack does not
# publish Postgres at all.
HOME_DB_BIND_ADDRESS=127.0.0.1
HOME_DB_PORT=5432

# ---- database ----
POSTGRES_USER=home
POSTGRES_PASSWORD=change-me
POSTGRES_DB=home

# ---- application ----
HOME_ENVIRONMENT=production
HOME_HOUSEHOLD_TIMEZONE=Europe/Budapest
# JSON array of the household's member names, seeded on a fresh database.
HOME_HOUSEHOLD_MEMBERS=["Árpád","Partner"]

# ---- deployment ----
# The prebuilt image to run. CI publishes this on every tag.
HOME_IMAGE=ghcr.io/arpaad/home-server:latest

# ---- Raspberry Pi (deploy/pi/) ----
# Mount point of the external disk holding the database and backups.
HOME_DATA_DIR=/mnt/home-data
# rsync target for off-device backups, e.g. lucky@100.64.0.5:backups/home
BACKUP_OFFSITE=
# ntfy.sh topic for backup-failure pushes; leave empty to only log
NTFY_TOPIC=
