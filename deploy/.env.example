# Copy to deploy/.env and adjust. deploy/.env is gitignored.

# Bind the API to the Pi's LAN address. LAN-only: this release has no
# authentication, so never bind it to a public interface.
HOME_BIND_ADDRESS=127.0.0.1
HOME_PORT=8080

# Postgres is only reachable from the host that runs the stack.
HOME_DB_BIND_ADDRESS=127.0.0.1
HOME_DB_PORT=5432

POSTGRES_USER=home
POSTGRES_PASSWORD=change-me
POSTGRES_DB=home

HOME_ENVIRONMENT=production
HOME_HOUSEHOLD_TIMEZONE=Europe/Budapest
