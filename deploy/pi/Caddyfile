# HTTPS for the household, on the LAN name. Caddy fetches a real Let's
# Encrypt certificate by proving control of the DuckDNS name through DNS —
# no port needs to be open to the internet, and it renews itself.
#
# HTTPS is not optional here: the PWA installs and the service worker (the
# offline mode) only run in a secure context, and a plain LAN IP is not one.

{$HOME_DOMAIN} {
	tls {
		dns duckdns {$DUCKDNS_TOKEN}
	}
	encode gzip
	reverse_proxy 127.0.0.1:8080
}
