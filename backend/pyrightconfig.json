{
  "include": ["app", "tests"],
  "exclude": [
    "migrations/versions",
    "**/venv",
    "**/.venv",
    "**/__pycache__"
  ],

  "pythonVersion": "3.14",
  "typeCheckingMode": "strict",
  "reportMissingImports": true,
  "reportMissingTypeStubs": false,
  "useLibraryCodeForTypes": true,

  "executionEnvironments": [
    {
      "root": ".",
      "pythonVersion": "3.14",
      "extraPaths": ["."]
    }
  ]
}
